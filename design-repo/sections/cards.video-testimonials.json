{
  "id": "cards.video-testimonials",
  "layer": "section",
  "purpose": "Video testimonial strip on /casestudies (VideoTestimonials.jsx).",
  "measuredFrom": "spec/pages/casestudies-index.md (Video testimonial Section)",
  "content": {
    "type": "object",
    "properties": { "videos": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "properties": { "posterAssetRef": { "type": "string" }, "companyName": { "type": "string" }, "quote": { "type": "string", "maxWords": 20 } }, "required": ["posterAssetRef", "companyName"], "additionalProperties": false } } },
    "required": ["videos"],
    "additionalProperties": false
  },
  "constraints": { "onePerPage": true, "routeRestriction": "casestudiesIndexOnly" },
  "motion": { "pattern": "appear-on-scroll", "reducedMotionFallback": "renders in final visible state immediately, no appear transition" },
  "assetRoles": {
    "customer-photo": { "enum": "customer-photo", "generationPolicy": "must-not-fabricate", "guidance": "Real named customers on video; never fabricate a likeness." },
    "customer-logo": { "enum": "customer-logo", "generationPolicy": "must-reuse-exact", "guidance": "Real company trademarks; never alter." }
  }
}
