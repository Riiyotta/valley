{
  "id": "faq.accordion-detailed",
  "layer": "section",
  "purpose": "Case-study-specific expand/collapse FAQ (FaqAccordion.jsx) — a genuinely different real component from the homepage/landing flat .vsq-faq panel; must not be merged or treated as a variant of faq.flat-panel-standalone.",
  "composes": ["faq-item"],
  "measuredFrom": "spec/pages/casestudy.md ('Heading + Desc FAQ', new FaqAccordion, 'Not the homepage .vsq-faq')",
  "content": {
    "type": "object",
    "properties": {
      "heading": { "type": "string", "maxWords": 10 },
      "faqs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "question": { "type": "string", "maxWords": 20 },
            "answer": { "type": "string", "maxWords": 80 }
          },
          "required": ["question", "answer"],
          "additionalProperties": false
        }
      }
    },
    "required": ["faqs"],
    "additionalProperties": false
  },
  "constraints": { "onePerPage": true, "routeRestriction": "casestudyDetailOnly" },
  "motion": { "pattern": "accordion-expand", "reducedMotionFallback": "instant expand/collapse" },
  "assetRoles": {}
}
